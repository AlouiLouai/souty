{
  "name": "souty",
  "version": "0.1.0",
  "private": true,
  "description": "Souty (صوتي) monorepo: the sign-to-speech PWA and its marketing site.",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:pwa": "turbo run dev --filter=@souty/pwa",
    "dev:marketing": "turbo run dev --filter=@souty/marketing",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "qr": "pnpm --filter @souty/qr run generate"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "catalog:"
  }
}
